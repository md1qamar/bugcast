{
  "name": "bugcast",
  "version": "2.0.0",
  "private": false,
  "description": "Local-first developer studio combining screen recording, live terminal sync, browser error bridge, GIF export, and local AI bug reporting.",
  "type": "module",
  "bin": {
    "bugcast": "./bin/cli.js"
  },
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:vite": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "start": "node bin/cli.js"
  },
  "keywords": [
    "screen-recorder",
    "developer-tools",
    "bug-report",
    "github-issue-generator",
    "loom-alternative",
    "privacy-first",
    "local-first",
    "devtools",
    "open-source"
  ],
  "author": "Open Source Community",
  "license": "MIT",
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "gifenc": "^1.0.3",
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  }
}
